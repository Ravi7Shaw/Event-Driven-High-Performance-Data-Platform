# Supply your own PostgreSQL URL; do not commit credentials.
DATABASE_URL=postgresql://localhost/eventvault
APP_ENV=development
LOG_LEVEL=INFO
CACHE_CAPACITY=512
CACHE_TTL=30
RATE_LIMIT=100
RATE_LIMIT_WINDOW=60
WORKER_BATCH_SIZE=100
WORKER_INTERVAL=0.2
WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_BASE=0.5
WORKER_ENABLED=true
DB_POOL_MIN=2
DB_POOL_MAX=20
MAX_BODY_BYTES=16384
WS_POLL_INTERVAL=0.1
WS_HEARTBEAT=15
WS_SEND_TIMEOUT=5
WS_MAX_CONNECTIONS=1000
# Set distinct random tokens; both are mandatory in production.
API_TOKEN=
ADMIN_TOKEN=
# Only development/test may enable fault injection (0..1).
FAILURE_RATE=0
